{
  "name": "@wiro-ai/example",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "pretest": "corepack pnpm --filter @wiro-ai/wirokit-react-native build",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "expo:config": "expo config --type public",
    "expo:export:ios": "expo export --platform ios --output-dir dist/ios",
    "expo:export:android": "expo export --platform android --output-dir dist/android"
  },
  "dependencies": {
    "@wiro-ai/wirokit-react-native": "workspace:*",
    "expo": "~54.0.35",
    "expo-status-bar": "~57.0.1",
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.0",
    "jest": "29.7.0",
    "jest-expo": "54.0.13",
    "react-dom": "19.1.0",
    "test-renderer": "1.1.0"
  }
}
