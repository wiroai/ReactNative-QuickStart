{
  "name": "@wiro-ai/example",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "pretest": "corepack pnpm --filter @wiro-ai/wiro-react-native build",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "expo:config": "expo config --type public",
    "expo:export:ios": "expo export --platform ios --output-dir dist/ios",
    "expo:export:android": "expo export --platform android --output-dir dist/android"
  },
  "dependencies": {
    "@wiro-ai/wiro-react-native": "workspace:*",
    "expo": "~58.0.23",
    "expo-file-system": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "jest": "30.5.2",
    "jest-expo": "58.0.14",
    "react-dom": "19.3.1",
    "test-renderer": "1.3.1"
  }
}
